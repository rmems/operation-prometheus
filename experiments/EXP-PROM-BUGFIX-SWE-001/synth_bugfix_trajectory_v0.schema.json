{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rmems/operation-prometheus/experiments/EXP-PROM-BUGFIX-SWE-001/synth_bugfix_trajectory_v0.schema.json",
  "title": "Synthetic bugfix trajectory v0",
  "description": "Teacher-generated alternate bugfix trajectory for EXP-PROM-BUGFIX-SWE-001. Not a replacement for schemas/pr_trajectory.schema.json.",
  "type": "object",
  "required": [
    "id",
    "seed_id",
    "exp_id",
    "teacher_model",
    "generated_at",
    "language",
    "domain",
    "task_type",
    "training_use",
    "issue_context",
    "before_context",
    "patch",
    "validation",
    "outcome",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "exp_id": {
      "type": "string",
      "const": "EXP-PROM-BUGFIX-SWE-001"
    },
    "teacher_model": {
      "type": "string",
      "const": "nvidia/nemotron-3-ultra-550b-a55b:free"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "const": "bugfix"
    },
    "training_use": {
      "type": "string",
      "const": "repair"
    },
    "issue_context": {
      "type": "string",
      "minLength": 1
    },
    "before_context": {
      "type": "string",
      "minLength": 1
    },
    "patch": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "result"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ci", "test", "manual", "review", "other"]
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "flaky"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "type": "string",
      "const": "merged"
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "seed_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "synthetic"
        },
        "seed_id": {
          "type": "string",
          "minLength": 1
        },
        "seed_repo": {
          "type": "string",
          "minLength": 1
        },
        "seed_pr_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
