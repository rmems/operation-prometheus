{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rmems/operation-prometheus/schemas/local_model_admission.schema.json",
  "title": "local_model_admission_v1",
  "description": "Fail-closed admission report for local model providers (e.g. loopback Ollama-served weights). The emitted bundle carries one singular decision report per candidate in `decisions[]`; each decision report is the canonical object consumed and hashed downstream, binding model identity, Ollama digest/quantization, runtime name and version, canonical loopback endpoint, rights identifier/terms source/terms digest, sanitized provider configuration, explicit cloud_fallback_allowed:false with proof evidence, the probe timestamp, and hashes of every frozen evidence input.",
  "type": "object",
  "required": [
    "schema_version",
    "closed",
    "counts",
    "decisions",
    "license_families",
    "evidence_digests",
    "input_digests",
    "bundle_errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "local_model_admission_v1"},
    "closed": {
      "type": "boolean",
      "description": "True only when every decision is accepted and bundle_errors is empty."
    },
    "counts": {
      "type": "object",
      "required": ["candidate_count", "accepted", "quarantined", "rejected"],
      "additionalProperties": false,
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/definitions/decision"}
    },
    "license_families": {
      "type": "array",
      "items": {"enum": ["spdx", "custom", "missing", "unknown"]},
      "uniqueItems": true
    },
    "evidence_digests": {
      "type": "array",
      "items": {"$ref": "#/definitions/sha256"},
      "uniqueItems": true
    },
    "input_digests": {
      "type": "object",
      "description": "SHA-256 of each frozen input file (admissions, rights, probe, inputs_manifest).",
      "additionalProperties": {"$ref": "#/definitions/sha256"}
    },
    "bundle_errors": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "type": "object",
      "description": "Singular local_model_admission_v1 decision report for one candidate.",
      "required": [
        "schema_version",
        "decision",
        "reasons",
        "model",
        "ollama_digest",
        "quantization",
        "upstream_revision",
        "runtime",
        "endpoint",
        "rights",
        "license_family",
        "provider_config",
        "cloud_fallback_allowed",
        "fallback_evidence",
        "probed_at",
        "input_digests",
        "evidence_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "local_model_admission_v1"},
        "decision": {"enum": ["accepted", "quarantined", "rejected"]},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "model": {"type": ["string", "null"]},
        "ollama_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "quantization": {"type": ["string", "null"]},
        "upstream_revision": {"type": ["string", "null"]},
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]}
          }
        },
        "endpoint": {"type": ["string", "null"]},
        "rights": {
          "type": "object",
          "required": ["identifier", "terms_source", "terms_sha256"],
          "additionalProperties": false,
          "properties": {
            "identifier": {"type": ["string", "null"]},
            "terms_source": {"type": ["string", "null"]},
            "terms_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "license_family": {
          "enum": ["spdx", "custom", "missing", "unknown"]
        },
        "provider_config": {"type": ["object", "null"]},
        "cloud_fallback_allowed": {"type": ["boolean", "null"]},
        "fallback_evidence": {
          "type": "object",
          "required": [
            "no_cloud",
            "cloud_fallback_allowed",
            "unsanitized_keys",
            "remote_endpoints"
          ],
          "additionalProperties": false,
          "properties": {
            "no_cloud": {"type": ["boolean", "null"]},
            "cloud_fallback_allowed": {"type": ["boolean", "null"]},
            "unsanitized_keys": {
              "type": "array",
              "items": {"type": "string"}
            },
            "remote_endpoints": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "probed_at": {"type": ["string", "null"]},
        "input_digests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/sha256"}
        },
        "evidence_digest": {"$ref": "#/definitions/sha256"}
      }
    }
  }
}
