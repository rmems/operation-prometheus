{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rmems.github.io/operation-prometheus/schemas/license_closure.schema.json",
  "title": "LicenseClosureReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "dataset_id",
    "inventory_path",
    "inventory_sha256",
    "source_count",
    "released_positive",
    "quarantined",
    "license_families",
    "unresolved_license_count"
  ],
  "properties": {
    "schema_version": {
      "const": "license-closure-v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "inventory_path": {
      "type": "string",
      "minLength": 1
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "released_positive": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "license",
          "license_family",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_family": {
            "type": "string",
            "enum": ["permissive", "copyleft", "custom"]
          },
          "custom_license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text_sha256", "attested_by"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "attested_by": { "type": "string", "minLength": 1 }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "spdx_identifier",
                "custom_object",
                "github_license_api",
                "markdown_disclosure",
                "pr_inventory"
              ]
            }
          }
        }
      }
    },
    "quarantined": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasons"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "unlicensed",
                "unknown_license",
                "source_license_missing",
                "source_license_changed",
                "declarations_disagree",
                "missing_evidence",
                "ambiguous_custom",
                "copyleft_without_disclosure",
                "pr_inventory_mismatch"
              ]
            }
          }
        }
      }
    },
    "license_families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissive", "copyleft", "custom", "unknown"],
      "properties": {
        "permissive": { "type": "integer", "minimum": 0 },
        "copyleft": { "type": "integer", "minimum": 0 },
        "custom": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "unresolved_license_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
