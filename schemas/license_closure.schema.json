{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rmems/operation-prometheus/schemas/license_closure.schema.json",
  "title": "Operation Prometheus license-closure manifest",
  "description": "Fail-closed report used before positive corpus publication. Source-derived licenses are preserved; this is not a compatibility or relicense verdict.",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_sha256",
    "license_families",
    "evidence_digests",
    "counts",
    "released_positives",
    "quarantined",
    "closed",
    "bundle_errors"
  ],
  "properties": {
    "schema_version": { "const": "license_closure_manifest_v1" },
    "snapshot_sha256": { "$ref": "#/definitions/sha256" },
    "license_families": {
      "type": "array",
      "items": { "enum": ["spdx", "custom"] },
      "uniqueItems": true
    },
    "evidence_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "digest", "family", "spdx_id"],
        "properties": {
          "repository": { "type": "string", "minLength": 3 },
          "digest": { "$ref": "#/definitions/sha256" },
          "family": { "enum": ["spdx", "custom"] },
          "spdx_id": { "type": ["string", "null"], "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "record_count",
        "released_positive_count",
        "quarantined_count",
        "unresolved_count"
      ],
      "properties": {
        "record_count": { "$ref": "#/definitions/count" },
        "released_positive_count": { "$ref": "#/definitions/count" },
        "quarantined_count": { "$ref": "#/definitions/count" },
        "unresolved_count": { "$ref": "#/definitions/count" }
      },
      "additionalProperties": false
    },
    "released_positives": {
      "type": "array",
      "items": { "$ref": "#/definitions/released_positive" }
    },
    "quarantined": {
      "type": "array",
      "items": { "$ref": "#/definitions/quarantined_row" }
    },
    "closed": { "type": "boolean" },
    "bundle_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inventory_license": {
      "type": "object",
      "required": ["spdx_id", "name", "url"],
      "properties": {
        "spdx_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "license_family": { "enum": ["spdx", "custom", "missing", "unknown"] },
    "reason_code": {
      "enum": [
        "source_license_missing",
        "source_license_unknown",
        "source_license_changed",
        "source_license_conflict",
        "snapshot_provenance_missing",
        "card_disclosure_missing",
        "declarations_disagree",
        "forge_license_substitution",
        "source_license_unresolved"
      ]
    },
    "released_positive": {
      "type": "object",
      "required": [
        "record_id",
        "repo",
        "pr_number",
        "state",
        "license_family",
        "spdx_id",
        "evidence_digest"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 3 },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "const": "released_positive" },
        "license_family": { "enum": ["spdx", "custom"] },
        "spdx_id": { "type": "string", "minLength": 1 },
        "evidence_digest": { "$ref": "#/definitions/sha256" },
        "custom_license": { "type": "object" },
        "inventory_license": { "$ref": "#/definitions/inventory_license" }
      },
      "additionalProperties": false
    },
    "quarantined_row": {
      "type": "object",
      "required": [
        "record_id",
        "repo",
        "pr_number",
        "state",
        "primary_reason",
        "reason_codes",
        "license_family",
        "evidence"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "repo": { "type": "string" },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "const": "quarantined" },
        "primary_reason": { "$ref": "#/definitions/reason_code" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/reason_code" },
          "uniqueItems": true
        },
        "license_family": { "$ref": "#/definitions/license_family" },
        "evidence": { "$ref": "#/definitions/evidence" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "record_license",
        "card_license",
        "manifest_license",
        "inventory_license",
        "evidence_digest",
        "declared_evidence_digest",
        "prior_evidence_digest",
        "snapshot_sha256",
        "repository_source_hash"
      ],
      "properties": {
        "record_license": { "type": ["string", "null"] },
        "card_license": { "type": ["string", "null"] },
        "manifest_license": { "type": ["string", "null"] },
        "inventory_license": {
          "anyOf": [
            { "$ref": "#/definitions/inventory_license" },
            { "type": "null" }
          ]
        },
        "evidence_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "declared_evidence_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "prior_evidence_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "repository_source_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
